// Mecon — heavy equipment rental & contracting operations system
//
// IMPORTANT — two deliberate deviations from the spec. Both originated as
// SQLite limitations; see NOTES.md for the full reasoning. Short version:
//
//  1. Every enum in the spec is a String here. The single source of truth for
//     allowed values is src/lib/enums.ts (TypeScript union types + zod
//     schemas). Allowed values are listed in a comment above each field so the
//     schema stays self-documenting.
//
//  2. Document.approvedFor is a real join table (DocumentApproval) rather than
//     an array column. The spec allowed for this ("array/join table").
//
// We are now on Postgres, which supports native enums and arrays — but both
// choices are being kept. The String enums stay because converting them is a
// typed refactor across every read, write and zod schema, with no behavioural
// gain: src/lib/enums.ts already enforces the same values. The join table
// stays because it is the better model regardless of provider.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 no longer accepts `url` here — the connection string lives in
// prisma.config.ts for migrations, and is passed to the driver adapter at
// runtime in src/lib/db.ts.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Access control
// ---------------------------------------------------------------------------
//
// Replaces the earlier shared-password review gate (src/proxy.ts's old Basic
// Auth check) — that had no accounts, no roles and no audit trail, which is
// exactly what this section adds. See src/lib/permissions.ts for what each
// role can actually do, and src/lib/auth/ for the session mechanics.

/// Email + password. Passwords are never stored in the clear — see
/// src/lib/auth/password.ts (Node's built-in scrypt, no external dependency).
model User {
  id           String @id @default(cuid())
  name         String
  email        String @unique
  passwordHash String

  /// ADMIN | OPERATIONS | VIEWER — see src/lib/enums.ts and
  /// src/lib/permissions.ts, the single place a role becomes an actual
  /// yes/no for a given action.
  role String

  sessions  Session[]
  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

/// An opaque random token, not a JWT — trivially revocable (delete the row)
/// and needs no signing-secret management, which matters more for a handful
/// of internal users than a stateless token would save. The cookie holds
/// only this token; every request re-checks it against the database, so a
/// deleted session or a deleted user stops working immediately.
model Session {
  id     String @id @default(cuid())
  token  String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// One row per create/update/delete anywhere in the app — "who did it and
/// when," viewable by Admin only. userName is a SNAPSHOT, not a live read
/// through the relation (same reasoning Payslip's salary fields already
/// follow) — a deleted user's history must still read who they were.
/// entityLabel is likewise a snapshot for the same reason: a renamed or
/// deleted record's audit history should still say what it used to be
/// called, not "—" or a stale join.
model AuditLog {
  id     String @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  userName String

  /// CREATE | UPDATE | DELETE
  action String

  /// The Prisma model name, e.g. "Contract", "Employee", "Document" — not
  /// an enum, so a new resource never needs a migration to be logged.
  entityType  String
  entityId    String
  entityLabel String?

  /// Field-level detail — an array of `{ field, was, now }`, already
  /// human-formatted (money as "QAR 3,000", dates as "31 Dec 2026", not
  /// raw halalas/ISO strings) at write time, not derived on read. That's
  /// deliberate: this log is meant to stay readable for years, and a
  /// later refactor of how a field is formatted or labelled must not
  /// silently reword history. Built by src/lib/audit.ts's diffField/
  /// createdField helpers, which also truncate any single value to 200
  /// chars — see their comments for why. CREATE rows use `was: null`
  /// (nothing existed before); DELETE rows use `now: null` the same way
  /// CREATE uses it in reverse — see the helpers. Only meaningful,
  /// human-relevant fields are ever included — never every column, never
  /// file contents (file NAMES only), and the row stays lean because only
  /// fields that actually changed are recorded, not a full before/after
  /// snapshot of the whole record.
  changedFields Json?

  createdAt DateTime @default(now())

  /// (entityType, entityId) is what makes a record's own "Change history"
  /// panel fast — see e.g. the Contract detail page.
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Parties and assets
// ---------------------------------------------------------------------------

model Customer {
  id            String  @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  notes         String?

  documents Document[]
  contracts Contract[]
  lpos      Lpo[]
  invoices  Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Equipment {
  /// Unit label as used on the yard, e.g. "CAT 320 #4"
  id   String @id @default(cuid())
  name String

  /// Excavator | Wheel Loader | Backhoe Loader (JCB) | Skid Steer (Bobcat)
  /// | Bulldozer | Crane | Dump Truck | Roller/Compactor | Forklift | Other
  type String

  /// JCB, Caterpillar, Hitachi, DAEWOO, SUNWARD, Bomag…
  brand String?

  /// Manufacturer's model designation — "3DX PLUS", "ZX190X-5A", "226B3".
  model String?

  /// Year of manufacture. Int, not a date: only the year is ever known.
  yearOfManufacture Int?

  /// Capacity as a NUMBER plus its unit, not free text.
  ///
  /// It currently lives inside the equipment name on the master sheet
  /// ("Boom Truck - 8.5Ton"), which makes "find me a 10 ton boom truck"
  /// impossible to answer without reading every row. Split out, it can be
  /// searched and compared. Float rather than Int because half-tonnes are
  /// normal (8.5, 9.2, 10.2); this is a specification, not money.
  capacityValue Float?

  /// TON | METRE | KG | CBM | HP | OTHER — see src/lib/enums.ts.
  /// Metres covers reach on a telehandler, where "17M" is the headline figure.
  capacityUnit String?

  /// Chassis / serial number
  serialNumber String?

  /// Registration number ("Reg. No." on the master sheet)
  plateNumber String?

  notes String?

  documents   Document[]
  assignments EquipmentAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([type])
  @@index([brand])
}

/// Operator became Employee 2026-08-15, ahead of the rest of the HR module
/// (see ROADMAP.md, Phase E0) — pulled forward because Phase B was about to
/// add operator-specific fields that would otherwise need migrating twice.
///
/// The physical table stays named "Operator" (@@map below): this is a
/// Prisma-model-level rename, not a data migration. Nothing moved.
model Employee {
  id          String  @id @default(cuid())
  name        String
  phone       String?
  nationality String?

  /// Phase B4/F3, surfaced in the UI Phase E1+ (2026-08-18) once the real
  /// staff list existed to put in it. The BUSINESS's own employee number,
  /// distinct from `id` (an internal system key nobody in the office would
  /// recognise).
  employeeNumber String?

  /// Literal job title as the business records it ("WELDER", "CAMP BOSS",
  /// "BACKHOE LOADER") — free text, not derived from `category`. category
  /// is the coarse bucket the app's logic branches on; this is what's
  /// actually printed on a payslip or shown on a staff list, and multiple
  /// distinct titles (WELDER, PAINTER, MECHANIC) can share one category.
  jobTitle String?

  /// OPERATOR | DRIVER | MECHANIC_WORKSHOP | HELPER_LABOURER | ADMIN_OFFICE
  /// | MANAGEMENT
  ///
  /// The real staff list (50 people, imported 2026-08-18) populates every
  /// category, but the /operators UI still only ever reads and writes
  /// category = OPERATOR — the other five have no UI yet, only real data
  /// waiting for it. See scripts/import-employees.ts (one-off, not a
  /// standing app feature) for the DESIGNATION → category mapping, which
  /// involved judgment calls on a few ambiguous titles (CAMP BOSS →
  /// MANAGEMENT, WS OFFICE BOY → MECHANIC_WORKSHOP) — confirm with the
  /// business if any read wrong.
  category String @default("OPERATOR")

  /// IN_HOUSE | MARKET
  source String @default("IN_HOUSE")

  notes String?

  // --- Payroll — Phase E3 ---------------------------------------------------
  //
  // Nullable throughout: not every employee has salary data entered yet, and
  // payroll generation skips (not zero-fills) anyone missing basicSalary
  // rather than silently paying them nothing. Integer HALALAS, same
  // convention as EquipmentAssignment.rateAmount — see src/lib/money.ts.

  basicSalary        Int?
  housingAllowance   Int?
  transportAllowance Int?
  foodAllowance      Int?
  siteAllowance      Int?
  otherAllowance     Int?

  /// Statutory minimum wage (QAR 500 housing / QAR 300 food) only applies
  /// when NOT provided in kind. Defaults to false — the stricter check —
  /// per owner confirmation rather than assumed.
  housingProvidedInKind Boolean @default(false)
  foodProvidedInKind    Boolean @default(false)

  /// For paying wages and, eventually, the WPS SIF export (deferred — see
  /// ROADMAP.md Phase E3, needs the actual bank's field spec first).
  bankName          String?
  bankAccountNumber String? /// IBAN or wage card number

  // --- Leave — Phase E2 -------------------------------------------------
  //
  // A real gap found while scoping E2: nothing recorded when someone
  // actually joined, so "eligible after 1 year", the 3-week/4-week service
  // tier, and later E4's gratuity years-of-service had no date to compute
  // from. Both added here — neither has real data yet (the imported 50-
  // person roster only had staff number/name/designation), so both start
  // empty and fill in as the business supplies them, same as
  // `employeeNumber` did.

  dateOfJoining DateTime?

  /// Requested alongside E2 for the future E4 encashment calc (unused
  /// annual leave paid out on exit) — not built this phase, needs this
  /// field to exist first. Also drives the derived Exited status —
  /// see src/lib/employee-status.ts. Status itself is NOT stored, per this
  /// app's "status is always derived" convention (see NOTES.md).
  dateOfExit DateTime?

  /// Per-employee override of the statutory annual leave entitlement (days
  /// per full service year) — null means "use the statutory default by
  /// service length" (src/lib/leave.ts). Company may pay above, never
  /// below the statutory floor.
  annualLeaveEntitlementOverrideDays Int?

  documents      Document[]
  assignments    OperatorAssignment[]
  qualifications OperatorQualification[]
  payslips       Payslip[]
  leaveRequests  LeaveRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([category])
  @@map("Operator")
}

/// Which equipment TYPES (not specific machines) an operator is qualified to
/// run — Phase B2. Free text, not an enum, for the same reason equipment type
/// itself is free text: a fixed list would force a new class of machine into
/// "Other" the day the fleet buys one. Suggestions come from the same source
/// equipment type entry already uses — see src/lib/equipment-options.ts.
model OperatorQualification {
  id         String   @id @default(cuid())
  operatorId String
  operator   Employee @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  equipmentType String

  createdAt DateTime @default(now())

  @@unique([operatorId, equipmentType])
  @@index([operatorId])
}

// ---------------------------------------------------------------------------
// Documents
// ---------------------------------------------------------------------------

/// Polymorphic by intent, but modelled with three nullable foreign keys rather
/// than a bare (ownerType, ownerId) pair. Reason: Prisma cannot express a
/// relation over an untyped ownerId, so `customer.documents` — which the spec
/// asks for on all three owners — would be impossible to query or include.
/// `ownerType` is kept as an explicit discriminator so the mental model from
/// the spec survives, and the app layer enforces "exactly one owner FK set".
model Document {
  id String @id @default(cuid())

  /// CUSTOMER | EQUIPMENT | OPERATOR — must agree with whichever FK is set
  ownerType String

  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  equipmentId String?
  equipment   Equipment? @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  operatorId  String?
  operator    Employee?  @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  /// Allowed values depend on ownerType — validated in src/lib/enums.ts
  ///   Customer:  CR (Commercial Registration) | Commercial License
  ///              | Computer Card | Other
  ///   Equipment: Registration (Istimara) | Insurance | Load Test
  ///              | 3rd Party Certificate | Other
  ///   Operator:  Qatar ID | Driving License | Operator License
  ///              | Medical Certificate | 3rd Party Certificate | Passport | Other
  documentType String

  documentNumber String?
  issueDate      DateTime?
  expiryDate     DateTime?

  /// False records a deliberate "this does not apply to this machine", so a
  /// blank is never ambiguous between "missing" and "not required".
  isApplicable Boolean @default(true)

  /// Phase B4/F1. Required whenever documentType is Other and the record is
  /// applicable — otherwise every Other document is indistinguishable from
  /// every other one. Optional when not applicable, same escape hatch the
  /// 3rd party fields already use for a deliberate "doesn't apply" record.
  otherLabel String?

  /// Phase B4/F2. Free text, every owner type, always optional — staff
  /// sometimes have something to say about a document that doesn't fit any
  /// other field.
  notes String?

  /// Vercel Blob URL — Phase C. The store is private (Vercel no longer
  /// offers public stores for new accounts, and a real access check beats
  /// an unguessable-URL model anyway), so this URL alone is useless without
  /// BLOB_READ_WRITE_TOKEN — nothing can read it directly. The browser never
  /// sees it: reads go through /api/documents/[id]/file, which holds the
  /// token server-side and is gated the same as everything else in the app,
  /// by the review-gate password (src/middleware.ts).
  /// Replaced the earlier `filePath`, which was never actually used —
  /// written for local storage/ (see .gitignore) before that was abandoned
  /// for the same "serverless has no persistent filesystem" reason SQLite was.
  fileUrl String?

  /// Original filename as uploaded — the Blob URL is a generated path, not
  /// something a person should have to read to know what the file is.
  fileName String?

  /// MIME type, so the document list can offer "View" for something the
  /// browser renders natively (PDF, image) vs "Download" for anything else.
  fileType String?

  // --- 3rd Party Certificate only -----------------------------------------

  /// Lifting Equipment Cert | Load Test | Operator Competency
  /// | Vehicle Inspection | Pressure Vessel | Other
  thirdPartyType String?

  /// Phase B4/F5. OPERATOR owner only — which equipment type this specific
  /// certificate covers (Assessment and TPC/QE both). An operator running a
  /// skid loader and a wheel loader holds two separate 3rd party
  /// certificate records, one per machine; multiple rows per operator
  /// already worked at the DB level (Phase B1), this is what makes that
  /// multiplicity mean something instead of being ambiguous. Free text,
  /// same vocabulary as Equipment.type and OperatorQualification.equipmentType
  /// — not an enum, for the same "fleet isn't a closed set" reason those
  /// aren't either. Required whenever applicable; not used on EQUIPMENT-owned
  /// 3rd party certificates, where the machine is already implicit in the
  /// owner.
  certifiedEquipmentType String?

  /// The certifying body, e.g. Bureau Veritas, SGS, TÜV
  issuingCompany String?

  /// Which site approval regimes this certificate is accepted under
  approvedFor DocumentApproval[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([equipmentId])
  @@index([operatorId])
  @@index([expiryDate])
}

/// Join table standing in for Document.approvedFor[]
model DocumentApproval {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// GENERAL_DOHA | QATAR_ENERGY | RAS_LAFFAN | MESAIEED | OTHER
  body String

  @@unique([documentId, body])
  @@index([documentId])
}

// ---------------------------------------------------------------------------
// Contracts
// ---------------------------------------------------------------------------

/// One contract per MACHINE. Three machines on a job means three contracts,
/// which is how the business records them internally.
///
/// The contract still belongs to the project, not to a particular machine:
/// mobilizationDate is fixed for its life, and the machine occupying the
/// contract can be replaced underneath it via assignments, so billing stays
/// continuous across a swap. Only ONE machine and ONE operator are assigned at
/// a time — a second assignment always means a replacement, never a parallel
/// machine.
model Contract {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  projectName String

  /// The actual place, free text — "Barzan Onshore", "Al Wakrah warehouse".
  /// Free text on purpose: a fixed list collapsed every unlisted location to
  /// "Other" and lost the real name. The form autocompletes it from locations
  /// already used, so the list grows with use.
  siteName String

  /// DOHA_GENERAL | QATAR_ENERGY | RAS_LAFFAN | MESAIEED | OTHER
  ///
  /// Which certification regime applies, kept SEPARATE from the name. General
  /// Doha work accepts any 3rd party certificate; the operator-run sites only
  /// accept their own approved companies. The name alone cannot be trusted to
  /// determine this, so it is recorded explicitly.
  siteRegime String

  /// Fixed. Belongs to the project — never edited on equipment/operator swap.
  mobilizationDate DateTime

  /// Null means ongoing
  closingDate DateTime?

  // Rate is NOT here — it lives on each EquipmentAssignment. A contract can
  // run several machines at once at different rates, so a single contract-wide
  // rate cannot express the real agreement.

  /// The LPO this contract draws on. A single LPO commonly covers several
  /// machines, so it is a shared record rather than fields repeated on every
  /// contract — otherwise the same LPO exists in three places that can drift
  /// apart, and consumption cannot be totalled against the real limit.
  /// Nullable: a contract can be recorded before its LPO arrives.
  lpoId String?
  lpo   Lpo?    @relation(fields: [lpoId], references: [id])

  // --- Mobilization -------------------------------------------------------

  /// The quotation this contract came from. One quotation often covers several
  /// contracts, so this is a plain reference, not a link — quotations live
  /// outside this system for now. Mobilization charges will be read from it later.
  quotationRef String?

  /// Who performs the mobilization — free text, autocompleted from what has
  /// been used before, so an unlisted hauler is never lost to an "Other" bucket.
  mobilizationBy String?

  /// MECON | OUTSOURCED | CUSTOMER | SUPPLIER — see src/lib/enums.ts.
  /// Kept alongside the name because "did we move it or did we pay someone"
  /// is a cost question, and the name alone cannot answer it.
  mobilizationParty String?

  /// FREE | CHARGED, or null to follow the duration rule automatically.
  ///
  /// The rule: a contract running a month or more mobilizes free of charge;
  /// under a month it is charged. Stored only when someone overrides that,
  /// so the normal case cannot go stale. See src/lib/mobilization.ts
  mobilizationCharge String?

  /// Integer halalas. Known once the quotation is consulted; blank until then.
  mobilizationAmount Int?

  /// Have WE settled the transporter's bill for mobilizing? This tracks money
  /// going out, not what the customer owes — that lives on the invoice.
  mobilizationPaid Boolean @default(false)

  // --- De-mobilization ----------------------------------------------------
  // A full mirror of mobilization. A machine coming off site is a real
  // movement with its own cost, and on a cross hire it is a separate
  // arrangement from the one that brought it in.

  demobilizationDate   DateTime?
  demobilizationBy     String?
  demobilizationParty  String?
  /// FREE | CHARGED, or null to follow the same duration rule as mobilization.
  demobilizationCharge String?
  /// Integer halalas
  demobilizationAmount Int?
  demobilizationPaid   Boolean   @default(false)

  // --- Cross hire ---------------------------------------------------------

  /// True when the machine is hired in from another supplier rather than
  /// owned. It still needs an Equipment record so its certificates are
  /// tracked, but the commercial arrangement is different: we pay the supplier
  /// as well as billing the customer.
  isCrossHire Boolean @default(false)

  /// Who we hired it from. Free text — suppliers come and go.
  crossHireSupplier String?

  /// Integer halalas per HOUR — what the supplier charges us. Same unit as the
  /// customer's rate so the margin is a straight subtraction.
  crossHireRate Int?

  // status is NOT stored — derived from mobilizationDate / closingDate so it
  // can never go stale. See src/lib/contract-status.ts

  equipmentAssignments EquipmentAssignment[]
  operatorAssignments  OperatorAssignment[]
  invoices             InvoiceContract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([lpoId])
  @@index([siteRegime])
  @@index([siteName])
  @@index([mobilizationDate])
}

/// A Local Purchase Order from the customer.
///
/// Shared across contracts: one LPO commonly covers several machines, and each
/// machine is its own contract. When more machines are mobilized later, the
/// customer issues a NEW LPO for that machine or batch, which becomes another
/// record here.
///
/// Type is NOT stored — an LPO is "open" when it has no amount ceiling and/or
/// no expiry, which is exactly the absence of those values. Deriving it means
/// the two can never disagree. See src/lib/lpo.ts
model Lpo {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  number String @unique

  /// When the customer issued it ("PO Date" on the master sheet). Distinct
  /// from validity, which is when it runs out.
  issuedDate DateTime?

  /// Integer halalas. NULL means an open amount — no ceiling agreed.
  amount Int?

  /// NULL means an open expiry — no end date agreed.
  validity DateTime?

  notes String?

  contracts Contract[]
  invoices  Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([number])
}

/// Never overwritten on replacement. To swap a machine: set endDate on the
/// current row to the day before, then insert a new row.
///
/// Only one is active at a time: a contract covers ONE machine. A second row
/// always means a replacement, never a parallel machine.
model EquipmentAssignment {
  id          String    @id @default(cuid())
  contractId  String
  contract    Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])

  startDate DateTime
  /// Null means currently assigned
  endDate   DateTime?

  /// The delivery note raised when THIS machine went to site.
  ///
  /// On the assignment rather than the contract because a new machine means a
  /// new delivery: a contract that swaps a machine has two deliveries, and the
  /// replacement's note would have nowhere to live. The machine's registration
  /// number is how the right note is found, and that is reachable through the
  /// equipment relation.
  deliveryNoteNumber String?
  deliveryDate       DateTime?

  /// PER_MONTH | PER_WEEK | PER_DAY — how the hire was ARRANGED.
  ///
  /// NOT the unit of rateAmount, which is always hourly. Nothing divides by
  /// this; it records a commercial term, and flags a monthly hire that only
  /// ran four days. Per assignment rather than per contract because a
  /// replacement machine can come in on different terms than the one it
  /// replaced.
  rateType String

  /// The HOURLY rate, in integer HALALAS (1 riyal = 100 halalas).
  ///
  /// Always hourly, whatever rateType says — invoices bill hours worked times
  /// this, and it is the figure printed in the Rate column. Halalas because
  /// rates carry decimals: 137.55 an hour is normal and riyals are too coarse.
  /// See src/lib/money.ts.
  rateAmount Int

  /// INITIAL | BREAKDOWN_REPLACEMENT | CUSTOMER_REQUEST | SCHEDULED_SWAP | OTHER
  reason String @default("INITIAL")
  note   String?

  invoiceLineItems InvoiceLineItem[]
  offHirePeriods   OffHirePeriod[]
  timesheets       EquipmentTimesheet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contractId])
  @@index([equipmentId])
}

/// A stretch where the machine was on site but NOT billable — breakdown,
/// customer stand-down, waiting on access.
///
/// Taken from the red OFF HIRE rows on the master sheet. Without it an invoice
/// bills every calendar day in the period, overcharges, and gets disputed —
/// the exact outcome the one-invoice-per-machine rule exists to contain.
/// Billing subtracts these days and shows the deduction rather than hiding it.
model OffHirePeriod {
  id                    String              @id @default(cuid())
  equipmentAssignmentId String
  equipmentAssignment   EquipmentAssignment @relation(fields: [equipmentAssignmentId], references: [id], onDelete: Cascade)

  startDate DateTime
  /// Null means still off hire
  endDate   DateTime?

  /// BREAKDOWN | CUSTOMER_STANDDOWN | AWAITING_ACCESS | WEATHER | OTHER
  reason String

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([equipmentAssignmentId])
}

/// Same replacement rule as EquipmentAssignment. operatorId is null when the
/// arrangement is WITHOUT_OPERATOR.
model OperatorAssignment {
  id         String    @id @default(cuid())
  contractId String
  contract   Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  operatorId String?
  operator   Employee? @relation(fields: [operatorId], references: [id])

  /// Which machine this operator ran is NOT stored here. The contract covers a
  /// single machine, so it is already known — and a stored copy would drift out
  /// of step the moment that machine was replaced. To answer "who was on this
  /// JCB in March", find the contracts holding that machine and the operator
  /// assignments whose dates overlap.

  /// WITH_OPERATOR | WITHOUT_OPERATOR | MARKET_OPERATOR
  arrangement String

  startDate DateTime
  /// Null means currently assigned
  endDate   DateTime?

  /// INITIAL | SICK_INJURED | BREAKDOWN_REPLACEMENT | CUSTOMER_REQUEST
  /// | SCHEDULED_SWAP | OTHER
  reason String @default("INITIAL")

  /// What we pay a subcontracted market operator, in integer halalas per hour.
  ///
  /// There is no matching "rebill": the customer is charged ONE rate covering
  /// machine and operator together, which lives on the equipment assignment.
  /// Margin is that rate minus this cost.
  operatorHourlyCost Int?

  note String?

  invoiceLineItems InvoiceLineItem[]
  timesheets       OperatorTimesheet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contractId])
  @@index([operatorId])
}

// ---------------------------------------------------------------------------
// Timesheets — Phase D
// ---------------------------------------------------------------------------
//
// Two fully separate models, one per assignment type, matching a rule
// confirmed explicitly with the user rather than assumed: equipment and
// operator hours are NEVER derived from each other, even though they are
// usually the same numbers in practice. EquipmentTimesheet drives invoicing
// (src/lib/hours.ts's hoursFor(), eventually); OperatorTimesheet drives
// payroll (Phase E3, not built yet). Reviewed against three real timesheets
// before building — see ROADMAP.md for what that changed.
//
// Each links to a specific assignment, not the bare contract — same
// reasoning EquipmentAssignment.deliveryNoteNumber already uses: a
// replacement machine or operator gets its own timesheet history, not a
// shared one that would misattribute hours across a mid-contract swap.

/// Reads: staff enter workingHours directly rather than the system deriving
/// it from startTime/endTime — real timesheets don't always subtract
/// cleanly (overnight shifts, unstated breaks), so the figure people sign
/// against is whatever they wrote, not whatever the clock math implies.
/// startTime/endTime are reference text only, never used in a calculation.
model EquipmentTimesheet {
  id              String @id @default(cuid())
  referenceNumber String @unique

  equipmentAssignmentId String
  equipmentAssignment   EquipmentAssignment @relation(fields: [equipmentAssignmentId], references: [id], onDelete: Cascade)

  year  Int
  month Int /// 1-12

  /// DRAFT | SIGNED — must be SIGNED before invoicing can read from it
  /// (that wiring is a follow-up step, not part of this build — see
  /// ROADMAP.md).
  status     String    @default("DRAFT")
  signedDate DateTime?

  days EquipmentTimesheetDay[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([equipmentAssignmentId, year, month])
  @@index([equipmentAssignmentId])
}

model EquipmentTimesheetDay {
  id          String             @id @default(cuid())
  timesheetId String
  timesheet   EquipmentTimesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  date      DateTime
  startTime String?
  endTime   String?

  /// Entered directly, not derived — see model comment above.
  workingHours   Float @default(0)
  breakdownHours Float @default(0)
  remarks        String?

  @@unique([timesheetId, date])
  @@index([timesheetId])
}

/// Regular/overtime split is deliberately NOT stored here — it's computed
/// from workingHours every time it's read (src/lib/overtime.ts), the same
/// "one source of truth" pattern as getDocumentStatus and profile
/// completeness elsewhere in this app. Storing it would let an edited hour
/// figure drift out of step with a stale split.
model OperatorTimesheet {
  id              String @id @default(cuid())
  referenceNumber String @unique

  operatorAssignmentId String
  operatorAssignment   OperatorAssignment @relation(fields: [operatorAssignmentId], references: [id], onDelete: Cascade)

  year  Int
  month Int /// 1-12

  /// DRAFT | SIGNED — must be SIGNED before payroll can read from it, once
  /// payroll (Phase E3) exists.
  status     String    @default("DRAFT")
  signedDate DateTime?

  days OperatorTimesheetDay[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([operatorAssignmentId, year, month])
  @@index([operatorAssignmentId])
}

model OperatorTimesheetDay {
  id          String            @id @default(cuid())
  timesheetId String
  timesheet   OperatorTimesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  date      DateTime
  startTime String?
  endTime   String?

  /// Entered directly, not derived — see EquipmentTimesheetDay's comment.
  workingHours   Float @default(0)
  breakdownHours Float @default(0)
  remarks        String?

  /// WORKING | LEAVE | PUBLIC_HOLIDAY — Phase E2. Defaulted from an
  /// APPROVED leave request overlapping this date when the timesheet is
  /// generated (src/lib/actions/timesheets.ts), editable afterward the same
  /// way workingHours is — leave approved after a timesheet already exists
  /// just means correcting the day by hand. Exists so a leave day reads as
  /// leave, not as an unworked gap — see ROADMAP.md Phase D's deferred item.
  dayType String @default("WORKING")

  /// Which leave type explains this day, set only when dayType = LEAVE. A
  /// snapshot copied from the LeaveRequest at generation/edit time, not a
  /// live foreign key — same "financial record, not a live read" reasoning
  /// Payslip's salary fields already follow (NOTES.md).
  leaveType String?

  @@unique([timesheetId, date])
  @@index([timesheetId])
}

// ---------------------------------------------------------------------------
// Billing (phase 3 — modelled now so the schema is complete)
// ---------------------------------------------------------------------------

/// An invoice normally covers ONE contract, which means one machine: if a
/// customer disputes a machine, payment on the others is not held up.
///
/// It CAN cover several, but only deliberately. Some customers ask for one
/// invoice across every machine on the same LPO, and refusing would just move
/// the work outside the system. Combining reintroduces the dispute risk, so it
/// is never the default.
model Invoice {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  /// The LPO being drawn down. Null when the contracts are not on one yet.
  /// Contracts on a single invoice must share this.
  lpoId String?
  lpo   Lpo?    @relation(fields: [lpoId], references: [id])

  /// Which contracts this invoice bills. Usually exactly one.
  contracts InvoiceContract[]

  invoiceNumber String @unique

  periodStart DateTime
  periodEnd   DateTime

  lineItems InvoiceLineItem[]

  /// Integer halalas
  totalAmount Int
  issuedDate  DateTime?
  dueDate     DateTime?

  /// Lifecycle only: DRAFT | ISSUED | PAID.
  /// OVERDUE is NOT stored — it is derived (ISSUED && dueDate < today &&
  /// paidDate == null) so it cannot go stale. See src/lib/invoice-status.ts
  status String @default("DRAFT")

  paidDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([lpoId])
  @@index([status])
}

/// Join between an invoice and the contracts it bills.
///
/// Explicit rather than derived from the line items, so "every invoice
/// touching this contract" stays a single cheap query even for a contract
/// whose lines were all zero in some period.
model InvoiceContract {
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@id([invoiceId, contractId])
  @@index([contractId])
}

/// One line per assignment slice, so an invoice covering a machine swap shows
/// each machine's actual days separately.
model InvoiceLineItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  /// EQUIPMENT | OPERATOR_REBILL | MOBILIZATION | DEMOBILIZATION | OTHER
  kind String

  /// The "PARTICULARS" column on the printed form.
  description String

  /// The "UOM" column — Hours or LS (lump sum). Stored on the line rather than
  /// derived, because an invoice must still print correctly years later even
  /// if the contract's rate type has since been changed.
  uom String

  /// The span this line covers, printed under the description as
  /// "From 01-07-2026 To 31-07-2026".
  ///
  /// Per LINE, not per invoice: a single invoice routinely bills two separate
  /// spans — 16-30 June and 1-11 July appear as two lines on one invoice.
  /// Null on a lump-sum line, which covers no period.
  periodStart DateTime?
  periodEnd   DateTime?

  /// Hours billed on this line. The calendar says 23 days but the invoice says
  /// 162.5 hours, because the machine did not work every hour of every day.
  hours Float?

  /// ESTIMATE | TIMESHEET — where `hours` came from. See src/lib/hours.ts.
  ///
  /// Stored rather than inferred because it is a claim about evidence, and it
  /// has to survive on the record: an invoice raised from a calendar estimate
  /// and one raised from a signed timesheet are not the same document, and
  /// months later nothing else could tell them apart. Null on lump-sum lines,
  /// which have no hours at all.
  hoursSource String?

  /// Traceability back to the assignment history this line was derived from
  equipmentAssignmentId String?
  equipmentAssignment   EquipmentAssignment? @relation(fields: [equipmentAssignmentId], references: [id])
  operatorAssignmentId  String?
  operatorAssignment    OperatorAssignment?  @relation(fields: [operatorAssignmentId], references: [id])

  /// Days, months or working hours depending on the contract rateType
  quantity Float
  /// Integer halalas
  unitRate Int
  /// Integer halalas
  amount   Int

  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Payroll — Phase E3
// ---------------------------------------------------------------------------

/// A date-range setting entered by staff, not hardcoded — moon-sighting
/// dates for Ramadan aren't something to guess at in code. Empty (no rows)
/// until the business adds this year's dates. Standard hours drop to 6/day,
/// 36/week for any payroll day falling inside one, with no pay reduction.
model RamadanPeriod {
  id        String   @id @default(cuid())
  year      Int
  startDate DateTime
  endDate   DateTime

  createdAt DateTime @default(now())

  @@unique([year])
}

/// One per calendar month, covering every employee's payslips for that
/// period. FINALIZED locks its payslips the same way a SIGNED timesheet
/// locks its daily rows.
model PayrollPeriod {
  id    String @id @default(cuid())
  year  Int
  month Int /// 1-12

  /// DRAFT | FINALIZED
  status         String    @default("DRAFT")
  finalizedDate  DateTime?

  payslips Payslip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month])
}

/// One per employee per PayrollPeriod. Salary fields are a SNAPSHOT taken at
/// generation time, not a live read of Employee — editing an employee's
/// salary later must never silently change a payslip already issued.
/// Same reasoning InvoiceLineItem already applies to its own amount fields.
model Payslip {
  id              String @id @default(cuid())
  referenceNumber String @unique

  payrollPeriodId String
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])

  basicSalary        Int
  housingAllowance   Int @default(0)
  transportAllowance Int @default(0)
  foodAllowance      Int @default(0)
  siteAllowance      Int @default(0)
  otherAllowance     Int @default(0)

  /// ESTIMATE | TIMESHEET — TIMESHEET only when a SIGNED OperatorTimesheet
  /// covered this employee for this period; every other employee (whole
  /// workforce coverage is the point of Phase E3 — see ROADMAP.md) gets an
  /// editable estimate. Same "labelled, never silently blended" idea as
  /// InvoiceLineItem.hoursSource and the timesheets themselves.
  hoursSource   String
  standardHours Float /// Full-month expected hours, Ramadan-aware — what a shortfall is measured against.
  regularHours  Float
  overtimeHours Float

  /// Hours-equivalent of this period's APPROVED leave, split by whether it's
  /// paid — Phase E2. Both feed shortfallDeduction below instead of every
  /// short hour being treated as unpaid absence (src/lib/payroll.ts):
  /// paidLeaveHours is excluded from the deduction, unpaidLeaveHours is
  /// deducted the same as a genuine gap. Shown separately on the payslip so
  /// the breakdown stays legible rather than silently blended into
  /// regularHours.
  paidLeaveHours   Float @default(0)
  unpaidLeaveHours Float @default(0)

  /// Flat amount + note, not a loan/advance ledger with balances — nobody's
  /// asked for that yet.
  deductionsAmount Int    @default(0)
  deductionsNote   String?

  /// Computed by src/lib/payroll.ts at generation/edit time and stored, not
  /// derived on read — a payslip is a financial record once issued, the same
  /// reasoning invoice line amounts already follow.
  shortfallDeduction Int
  overtimePay        Int
  grossPay           Int
  netPay             Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([payrollPeriodId, employeeId])
  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// Leave — Phase E2
// ---------------------------------------------------------------------------

/// A specific declared public holiday (Eid Al Fitr, Eid Al Adha, Qatar
/// National Day, ...) — entered by staff as a date range, same reasoning
/// RamadanPeriod uses: Islamic holidays are moon-sighting dependent and
/// cannot be hardcoded or guessed at in code. A public holiday landing
/// inside an approved annual leave request does not consume a leave day —
/// see src/lib/leave.ts.
model PublicHoliday {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime

  createdAt DateTime @default(now())

  @@index([startDate])
}

/// One leave request per continuous stretch. Balance, accrual and carry-over
/// are all COMPUTED from the full history of a employee's APPROVED requests
/// (src/lib/leave.ts) rather than stored as a running ledger — same "status
/// is always derived" convention as document status, contract status and the
/// timesheet overtime split (NOTES.md), so a balance can never drift out of
/// step with a request that gets edited, cancelled or approved late.
///
/// "Approval" is a status field only, not a real approval trail — there is
/// no user-account system yet to authenticate who decided what (confirmed
/// scope, ROADMAP.md). decidedBy is free text for whoever is using the
/// system to type their own name against the decision.
model LeaveRequest {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// ANNUAL | SICK | UNPAID | HAJJ | MATERNITY | EMERGENCY | PUBLIC_HOLIDAY
  /// — see src/lib/enums.ts.
  leaveType String

  startDate DateTime
  endDate   DateTime

  /// PENDING | APPROVED | REJECTED | CANCELLED
  status String @default("PENDING")

  requestedDate DateTime  @default(now())
  decidedBy     String?
  decidedDate   DateTime?

  /// Overrides this leave type's default paid/unpaid treatment for this one
  /// request only — e.g. the company granting a specific Emergency leave as
  /// paid, which is unpaid by default (src/lib/leave.ts), pending the
  /// business's own policy answer (see ROADMAP.md open questions). Null
  /// follows the type default; Sick leave's tiering ignores this and always
  /// computes its own full/half/unpaid split.
  paidOverride Boolean?

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([leaveType])
  @@index([status])
  @@index([startDate])
}
